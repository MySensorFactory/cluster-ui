# API URLs - These can be any value when using mock server 
REACT_APP_HOME_API_BASE_URL=/api/home
REACT_APP_REPORTS_API_BASE_URL=/api/reports
REACT_APP_CONFIG_API_BASE_URL=/api/config

# Keycloak configuration - Not used with mock server
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=cluster
REACT_APP_CLIENT_ID=cluster-ui

# Enable mock server (true/false)
REACT_APP_USE_MOCK_SERVER=true 